<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.de-gupta</groupId>
        <artifactId>security.parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>security.argus</artifactId>
    <version>3.0.1-SNAPSHOT</version>

    <name>${artifactId}</name>
    <description>A library for orchestrating the authentication using tokens</description>
    <url>https://github.com/de-gupta/security.argus.git</url>

    <properties>
        <themis.version>4.0.1</themis.version>
        <hermes.version>3.0.1</hermes.version>
        <augustus.version>3.0.1</augustus.version>

        <caffeine.version>3.2.3</caffeine.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>security.themis</artifactId>
            <version>${themis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>security.hermes</artifactId>
            <version>${hermes.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>security.augustus</artifactId>
            <version>${augustus.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>aletheia</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.de-gupta</groupId>
            <artifactId>athena</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
    </dependencies>

    <scm>
        <connection>scm:git:ssh://git@github.com/de-gupta/security.argus.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/de-gupta/security.argus.git</developerConnection>
        <url>https://github.com/de-gupta/security.argus.git</url>
        <tag>HEAD</tag>
    </scm>
</project>